# Supabase — find these in your project: Settings → API (Project URL and API keys).
# Public values (safe in the browser; row-level security protects the data):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" key (legacy) or the new "publishable" key (sb_publishable_…):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret (never prefix with NEXT_PUBLIC_, never commit):
# the "service_role" key (legacy) or the new "secret" key (sb_secret_…)
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Public site URL, used for auth redirects (magic links, OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
